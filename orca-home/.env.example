# ORCA Marine Intelligence Configuration
# SIH 2026 Problem Statement 26176 (ISRO / Space Technology)

# ArcGIS Maps SDK API Key (Optional: Public basemaps work automatically without key)
VITE_ARCGIS_API_KEY=your_arcgis_api_key_here

# INCOIS GeoServer Endpoint
VITE_INCOIS_WMS_URL=https://incois.gov.in/geoserver/wms
VITE_INCOIS_WFS_URL=https://incois.gov.in/geoserver/PFZ_Automation/ows

# IMD Cyclone Service Reference
VITE_IMD_API_URL=https://api.imd.gov.in/api/v1/cyclone_track

# Copernicus Marine / Physics Service Reference
VITE_COPERNICUS_API_URL=https://marine.copernicus.eu/

# ---------------------------------------------------------------------------
# Service URL Configuration
# These control where orca-home points for orac-frontend and orac-backend.
# Defaults below work for local development with zero setup changes.
# In production (Render / Vercel), set these to your deployed service URLs.
# ---------------------------------------------------------------------------

# URL where orac-frontend is hosted (set to the deployed orac-frontend URL in production)
VITE_ORAC_FRONTEND_URL=http://localhost:3000

# URL where orac-backend is hosted (set to the deployed orac-backend URL in production)
VITE_BACKEND_BASE_URL=http://localhost:8000
