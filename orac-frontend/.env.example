# orac-frontend Environment Configuration
# -----------------------------------------------------------------------
# URL where orac-backend is hosted.
# Default below works for local development with zero setup changes.
# In production (Render / Vercel / Railway), set this to the deployed
# orac-backend URL, e.g.: https://orac-backend.onrender.com
VITE_BACKEND_BASE_URL=http://localhost:8000

# ArcGIS Maps SDK API Key (optional; public basemaps work without a key)
VITE_ARCGIS_API_KEY=
