# orac-frontend Environment Configuration
# -----------------------------------------------------------------------
# URL where orac-backend is hosted.
# Default below works for local development with zero setup changes.
# In production (Render / Vercel / Railway), set this to the deployed
# orac-backend URL, e.g.: https://orac-backend.onrender.com
VITE_BACKEND_BASE_URL=http://localhost:8000

# ArcGIS Maps SDK API Key (optional; public basemaps work without a key)
# When unset, the map renders with the free OpenStreetMap basemap instead of
# the ArcGIS oceans basemap. No other configuration is required.
VITE_ARCGIS_API_KEY=

# URL of the orca-home shell (the parent app that embeds this frontend in an
# iframe). Used to validate `ORCA_LANGUAGE_SYNC` postMessage events so only the
# real shell can change this app's language. In local development any localhost
# origin is accepted automatically; set this for production deployments.
VITE_ORCA_HOME_URL=http://localhost:5173
