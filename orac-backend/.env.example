# =================================================================
# ORCA Marine Intelligence Platform (SIH26176) - Environment Config
# =================================================================

# LLM Integration (Anthropic Claude)
# If left unset, deterministic fallback synthesizers are used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Bhashini ULCA Multilingual Pipeline Settings
# Used for Indian regional language translations (Kannada, Tamil, Telugu, Hindi, etc.)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_ULCA_URL=https://dhruva-api.bhashini.gov.in/services/inference/pipeline

# SQLite Database Settings
DATABASE_URL=sqlite:///./orca.db

# Application Runtime Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
APP_NAME=ORCA Marine Intelligence Platform
APP_VERSION=1.0.0

# CORS Configuration (comma-separated origins)
# In production, specify explicit trusted frontend origin(s), e.g.: http://localhost:5173,http://localhost:3000
# Wildcard '*' disables credentials per browser security standards.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Missing Location Demo Fallback
# If true, queries with no location default to Mangalore with an explicit demo warning.
# If false, queries with no location return status="partial", conservative CAUTION, and require location.
DEMO_DEFAULT_LOCATION_ENABLED=true

# =================================================================
# Role-Based Authentication & Provider Configuration
# =================================================================
# Set to true for local development testing (enables dev_otp exposure in responses).
# In production, AUTH_DEV_MODE must be set to false.
AUTH_DEV_MODE=false

# Secret key used for signing JWT tokens and HMAC OTP hashing.
# MUST be set to a long, random value in production (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# Placeholder values are rejected at startup; if left empty, an ephemeral key is generated
# for local development only (sessions will not survive a restart).
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cookie Security Settings (Set AUTH_COOKIE_SECURE=true in production HTTPS)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# Administrator Bootstrap Settings
ADMIN_EMAIL=admin@orca-marine.gov.in
ADMIN_PASSWORD=CHANGE_ME_SECURE_ADMIN_PASSWORD
# Admin seeding is opt-in: set to true only when you intentionally want the
# bootstrap admin created from ADMIN_PASSWORD above.
ADMIN_SEED_ENABLED=false

# OTP Service Configuration (options: development, twilio, msg91)
OTP_PROVIDER=development
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# SMS Gateway
# Options: mock, textbee
SMS_PROVIDER=mock

# TextBee credentials
# NEVER expose TEXTBEE_API_KEY to the frontend or commit it to source control.
TEXTBEE_API_KEY=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Optional: force a specific registered TextBee device.
# Leave empty to use TextBee's default/most recently active enabled device.
TEXTBEE_DEVICE_ID=

# Optional: choose a SIM on a dual-SIM Android device.
TEXTBEE_SIM_SUBSCRIPTION_ID=

TEXTBEE_TIMEOUT_SECONDS=15

# Legacy provider compatibility
SMS_API_KEY=
SMS_API_SECRET=

# Email Service Configuration (options: development, smtp)
EMAIL_PROVIDER=development
EMAIL_FROM=noreply@orca-marine.gov.in
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Session Security
SESSION_EXPIRY_SECONDS=86400
